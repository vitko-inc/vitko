{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runners.vitko.inc/schemas/vitko.orgs/v1",
  "title": "Organizations",
  "description": "Organizations the caller can use.",
  "type": "object",
  "required": [
    "schema",
    "data"
  ],
  "properties": {
    "schema": {
      "const": "vitko.orgs/v1"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "login": {
            "type": "string"
          },
          "role": {
            "type": [
              "string",
              "null"
            ],
            "description": "GitHub role for people (admin or member); null for tokens and CI jobs."
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "display_name": {
            "type": "string"
          },
          "fast_path": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "login",
          "scopes"
        ]
      }
    }
  }
}
