{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runners.vitko.inc/schemas/vitko.schema-list/v1",
  "title": "Schema list",
  "description": "Every JSON Schema vitko's output follows.",
  "type": "object",
  "required": [
    "schema",
    "schemas"
  ],
  "properties": {
    "schema": {
      "const": "vitko.schema-list/v1"
    },
    "schemas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "id",
          "title"
        ]
      }
    }
  }
}
