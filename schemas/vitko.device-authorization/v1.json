{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runners.vitko.inc/schemas/vitko.device-authorization/v1",
  "title": "Device authorization",
  "description": "The start of a device login (RFC 8628).",
  "type": "object",
  "required": [
    "schema",
    "device_code",
    "user_code",
    "verification_uri",
    "expires_in",
    "interval"
  ],
  "properties": {
    "schema": {
      "const": "vitko.device-authorization/v1"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "device_code": {
      "type": "string"
    },
    "user_code": {
      "type": "string"
    },
    "verification_uri": {
      "type": "string"
    },
    "verification_uri_complete": {
      "type": "string"
    },
    "expires_in": {
      "type": "integer"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "interval": {
      "type": "integer"
    }
  }
}
