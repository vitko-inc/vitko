{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runners.vitko.inc/schemas/vitko.oidc-trust/v1",
  "title": "CI trust rules",
  "description": "Rules that give GitHub Actions jobs more than read access to their own repository.",
  "type": "object",
  "required": [
    "schema",
    "data"
  ],
  "properties": {
    "schema": {
      "const": "vitko.oidc-trust/v1"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "github_org_id": {
            "type": "integer"
          },
          "repository": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          },
          "job_workflow_ref": {
            "type": "string"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "created_by": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "repository",
          "scopes"
        ]
      }
    },
    "default": {
      "type": "string"
    }
  }
}
